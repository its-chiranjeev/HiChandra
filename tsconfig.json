{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "@hichandra/common": [
        "libs/common/src"
      ],
      "@hichandra/common/*": [
        "libs/common/src/*"
      ],
      "@hichandra/database": [
        "libs/database/src"
      ],
      "@hichandra/database/*": [
        "libs/database/src/*"
      ],
      "@hichandra/dtos": [
        "libs/dtos/src"
      ],
      "@hichandra/dtos/*": [
        "libs/dtos/src/*"
      ],
      "@hichandra/entities": [
        "libs/entities/src"
      ],
      "@hichandra/entities/*": [
        "libs/entities/src/*"
      ],
      "@hichandra/repositories": [
        "libs/repositories/src"
      ],
      "@hichandra/repositories/*": [
        "libs/repositories/src/*"
      ],
      "@hichandra/email-services": [
        "libs/email-services/src/index.ts"
      ],
      "@hichandra/s3": [
        "libs/s3/src"
      ],
      "@hichandra/s3/*": [
        "libs/s3/src/*"
      ],
      "@hichandra/gateway": [
        "libs/gateway/src"
      ],
      "@hichandra/gateway/*": [
        "libs/gateway/src/*"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "dist",
    "**/*.spec.ts",
    "apps/**/test/**/*"
  ]
}